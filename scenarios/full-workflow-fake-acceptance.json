            { "runKey": "study:ours:VinDr:test:seed42", "status": "completed", "workerId": "worker-a", "sessionId": "s1" },
            { "runKey": "study:baseline:VinDr:test:seed42", "status": "failed", "workerId": "worker-b", "sessionId": "s2" }
          ]
        }
      }
    },
    {
      "action": "serverOnline",
