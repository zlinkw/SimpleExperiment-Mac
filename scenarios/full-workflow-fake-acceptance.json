        "payload": {
          "schedulerStates": [
            { "runKey": "study:ours:VinDr:test:seed42", "status": "running", "workerId": "worker-a", "sessionId": "s1" },
            { "runKey": "study:baseline:VinDr:test:seed42", "status": "queued", "workerId": "worker-b", "sessionId": "s2" }
          ]
        }
      }
    },
    {
